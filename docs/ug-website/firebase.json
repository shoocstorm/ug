{
  "hosting": {
    "site": "ultra-graph",
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      ".firebase/**",
      ".git/**",
      "**/.*",
      "**/node_modules/**",
      "docs/**",
      "**/*.md"
    ],
    "headers": [
      {
        "source": "/demo/**",
        "headers": [
          {
            "key": "Cross-Origin-Opener-Policy",
            "value": "same-origin"
          },
          {
            "key": "Cross-Origin-Embedder-Policy",
            "value": "require-corp"
          }
        ]
      }
    ]
  }
}
